{
  "name": "chatty-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "author": "Hwan Ngo",
  "description": "Play and chat smarter with chatty-buddy - an amazing open-source web app with a chatty-buddy API!",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@react-oauth/google": "^0.13.5",
