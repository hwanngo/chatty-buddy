    "i18next-http-backend": "^4.0.9",
    "katex": "^0.19.1",
    "lodash": "^4.18.1",
    "match-sorter": "^8.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-scroll-to-bottom": "^4.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
