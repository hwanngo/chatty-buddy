      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "postcss@<8.5.18": ">=8.5.18",
      "fast-uri@<3.1.9": ">=3.1.9 <4",
      "undici@>=8.0.0 <8.12.2": ">=8.12.2 <9",
      "browserslist@<4.28.7": ">=4.28.7 <5",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3",
      "katex@<0.18.2": ">=0.18.2",
      "serialize-javascript@<7.1.3": ">=7.1.3 <8",
      "postcss-selector-parser@<6.1.5": ">=6.1.5 <7",
