    "i18next-http-backend": "^3.0.5",
    "katex": "^0.16.45",
    "lodash": "^4.18.1",
    "match-sorter": "^8.3.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
    "react-scroll-to-bottom": "^4.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^14.0.0",
